# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
GCS_BUCKET=your-project-id-uploads

# Local dev options
USE_MEMORY_STORE=true
PORT=3000
# USE_MOCK_AI=true

# --- Firebase Auth (OPSIONAL — fitur sync antar device) ---
# Setup post-hackathon. Tanpa ini, app tetap jalan dalam mode anonim
# (sesi terikat per-deviceId di localStorage).
# Cara dapat: console.firebase.google.com → buat project → Project Settings
# → General → Web app config
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
