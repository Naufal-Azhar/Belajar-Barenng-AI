# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
GCS_BUCKET=your-project-id-uploads

# Local dev options
USE_MEMORY_STORE=true
PORT=3000
# USE_MOCK_AI=true

# --- Auth profil (username + PIN, TANPA email) ---
# Kunci untuk menandatangani cookie session (HMAC). WAJIB di-set di produksi
# dengan string acak panjang. Tanpa ini, dipakai fallback dev yang tidak aman.
# Generate: `openssl rand -hex 32`
AUTH_SECRET=ganti-dengan-string-acak-panjang

# --- Gerbang kode akses (bagikan ke juri) ---
# Kode tunggal yang harus dimasukkan pengunjung sebelum bisa memakai aplikasi.
ACCESS_CODE=ganti-kode-juri

# --- Cap pengguna aktif ---
# Maksimum pengguna aktif bersamaan (default 20). Andalkan Cloud Run max-instances 1.
# MAX_ACTIVE_USERS=20
